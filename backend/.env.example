# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/bank_transaction_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_recommended
JWT_EXPIRE=7d

# Frontend CORS URL (update after Vercel deployment)
CLIENT_URL=http://localhost:3000

# Email Service Configuration (Gmail with App Password)
SMTP_SERVICE=gmail
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# Server Port (Render will set this automatically)
PORT=3000
NODE_ENV=production
